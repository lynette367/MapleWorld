最为简单直接。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"收入要求："}]," 只要有 W-2 或相关的 1042-S 收入即可申报。"]}]]}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]}]}]]}],["$L20"],"$L21"]}]
