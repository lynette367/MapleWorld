0:{"buildId":"vU9imYCx60Wv-EVSe9Cp5","rsc":["$","$1","c",{"children":[["$","main",null,{"className":"pb-16 text-brand-ink","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"F1 留学生报税身份判定：你是 Resident 还是 Non-Resident？\",\"description\":\"面向在美 F1 / OPT 留学生的判断说明书：解释 SPT 测试与留美满五年规则，给出身份切换判断清单。\",\"image\":\"https://www.mapleworld.online/og-image.png\",\"totalTime\":\"PT30M\",\"estimatedCost\":{\"@type\":\"MonetaryAmount\",\"currency\":\"USD\",\"value\":\"0\"},\"step\":[{\"@type\":\"HowToStep\",\"name\":\"确认错误类型\",\"text\":\"检查你是否误将 1040-NR 填成了 1040，并确认是否误领了 Standard Deduction\",\"url\":\"https://www.mapleworld.online/guides/f1-tax-residency#step1\"},{\"@type\":\"HowToStep\",\"name\":\"准备 1040-X 修正表\",\"text\":\"下载并填写 1040-X 修正表，将 Resident 身份修正为 Non-resident\",\"url\":\"https://www.mapleworld.online/guides/f1-tax-residency#step2\"},{\"@type\":\"HowToStep\",\"name\":\"重新填写 1040-NR\",\"text\":\"按照 Non-resident 身份重新填写 1040-NR 表格\",\"url\":\"https://www.mapleworld.online/guides/f1-tax-residency#step3\"},{\"@type\":\"HowToStep\",\"name\":\"邮寄 IRS\",\"text\":\"将修正后的表格邮寄至 IRS 指定地址\",\"url\":\"https://www.mapleworld.online/guides/f1-tax-residency#step4\"}]}"}}],["$","section",null,{"className":"px-4 py-8 sm:py-12 bg-gradient-to-b from-brand-pink/10 to-transparent","children":["$","div",null,{"className":"page-shell","children":["$","div",null,{"className":"max-w-3xl","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-6","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"报税攻略\",\"item\":\"https://www.mapleworld.online/guides\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"F1 留学生报税身份判定：你是 Resident 还是 Non-Resident？\"}]}"}}],["$","ol",null,{"className":"flex flex-wrap items-center gap-2 text-xs sm:text-sm text-brand-ink/50","children":[["$","li",null,{"children":["$","$L2",null,{"href":"/","className":"hover:text-brand-pinkdeep transition-colors","children":"首页"}]}],[["$","$1","0",{"children":[["$","li",null,{"className":"select-none","children":"/"}],["$","li",null,{"children":["$","$L2",null,{"href":"/guides","className":"hover:text-brand-pinkdeep transition-colors","children":"报税攻略"}]}]]}],["$","$1","1",{"children":[["$","li",null,{"className":"select-none","children":"/"}],["$","li",null,{"children":["$","span",null,{"className":"text-brand-ink/80 font-medium","children":"F1 留学生报税身份判定：你是 Resident 还是 Non-Resident？"}]}]]}]]]}]]}],["$","h1",null,{"className":"mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-ink leading-tight drop-shadow-sm","children":"F1 留学生报税身份判定：你是 Resident 还是 Non-Resident？"}],["$","p",null,{"className":"mt-6 text-lg text-brand-ink/80 leading-relaxed font-medium","children":"面向在美 F1 / OPT 留学生的判断说明书：解释 SPT 测试与留美满五年规则，给出身份切换判断清单。"}],["$","div",null,{"className":"mt-6 inline-block bg-red-100/80 text-red-900 px-5 py-3 rounded-xl border border-red-200 font-bold shadow-sm","children":"🚨 紧急提醒：4.15 截止前必须完成修正，避免罚款和签证风险！"}]]}]}]}],["$","section",null,{"className":"px-4 py-8","children":["$","div",null,{"className":"page-shell","children":["$","div",null,{"className":"max-w-4xl","children":[["$","article",null,{"className":"prose prose-pink max-w-none space-y-12","children":[[["$","section","先给结论：身份路径决定表格与工具-0",{"className":"space-y-6 ","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold pb-3 text-brand-ink inline-block border-b-2 border-brand-pink/30","children":"先给结论：身份路径决定表格与工具"}],["$","div",null,{"className":"space-y-4 text-sm sm:text-base text-brand-ink/75","children":[["$","p","0",{"className":"text-lg text-brand-ink/80 leading-relaxed bg-amber-50 p-6 rounded-2xl border border-amber-200","children":["$","strong",null,{"className":"text-amber-900","children":"对 F1 / OPT 留学生来说，报税最容易卡住的不是软件怎么填，而是你到底走哪条身份路径。只要路径错了，1040-NR 和 8843 等表格就会被错配，甚至把自己当 Resident 报。"}]}],"$L3"]}]]}],"$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc"],"$Ld"]}],"$Le","$Lf"]}]}]}]]}],["$L10"],"$L11"]}],"loading":null,"isPartial":false}
3:["$","p","1",{"children":"Sprintax / TurboTax 只是工具，工具不会帮你判断身份。你真正需要的是一个清晰的身份判定流程：先决定路径，再决定要用哪种软件与清单。"}]
4:["$","section","SPT 测试：Resident 与 Non-Resident 的核心判断框架-1",{"className":"space-y-6 ","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold pb-3 text-brand-ink inline-block border-b-2 border-brand-pink/30","children":"SPT 测试：Resident 与 Non-Resident 的核心判断框架"}],["$","div",null,{"className":"space-y-4 text-sm sm:text-base text-brand-ink/75","children":[["$","p","0",{"children":"SPT 测试（Substantial Presence Test）决定你是否满足居民身份条件。它不是一句“待满五年”那么简单，而是按日历年与天数加权计算。理解 SPT 测试的意义在于：你可以知道自己什么时候可能发生报税身份切换，而不是盲目跟随别人路径。"}],["$","p","1",{"children":"F1 身份通常有“exempt”年限，也就是在某些年份里不计入 SPT。多数情况下，F1 前 5 个日历年更像 Non-Resident，但如果你跨了年、出入境频繁，最好仍做一次明确判断。"}]]}]]}]
5:["$","section","SPT 测试常见误解（把概念翻译成行动）-2",{"className":"space-y-6 ","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold pb-3 text-brand-ink inline-block border-b-2 border-brand-pink/30","children":"SPT 测试常见误解（把概念翻译成行动）"}],["$","div",null,{"className":"space-y-4 text-sm sm:text-base text-brand-ink/75","children":[["$","p","0",{"children":"很多同学把 SPT 测试理解成“待够五年就自动变 Resident”，这会导致报税身份切换判断失真。实际情况是：你需要确认入境年份、报税年度，以及当年是否处在 exempt 年限内。"}],["$","ul","1",{"className":"space-y-3 list-disc pl-6 text-brand-ink/75","children":[["$","li","0",{"className":"pl-2 ","children":"误解 1：只算连续 12 个月。实际是按日历年。"}],["$","li","1",{"className":"pl-2 ","children":"误解 2：只看同学的路径。实际要看自己的入境年份。"}],["$","li","2",{"className":"pl-2 ","children":"误解 3：只看收入类型。身份判断优先于材料类型。"}]]}]]}]]}]
6:["$","section","3 步判断流程（不需要算复杂公式）-3",{"className":"space-y-6 ","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold pb-3 text-brand-ink inline-block border-b-2 border-brand-pink/30","children":"3 步判断流程（不需要算复杂公式）"}],["$","div",null,{"className":"space-y-4 text-sm sm:text-base text-brand-ink/75","children":[["$","ol","0",{"className":"space-y-3 list-decimal pl-6 text-brand-ink/75","children":[["$","li","0",{"className":"pl-2 ","children":"确认入境年份与当年报税年度，算出你是第几个 F1 日历年。"}],["$","li","1",{"className":"pl-2 ","children":"把 1040-NR 与 1040 的路径分别列出来，看哪条更匹配。"}],["$","li","2",{"className":"pl-2 ","children":"再选择 Sprintax / TurboTax 等工具，不要先选工具再补身份。"}]]}]]}]]}]
7:["$","section","留美满五年规则：最容易被误解的一句话-4",{"className":"space-y-6 ","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold pb-3 text-brand-ink inline-block border-b-2 border-brand-pink/30","children":"留美满五年规则：最容易被误解的一句话"}],["$","div",null,{"className":"space-y-4 text-sm sm:text-base text-brand-ink/75","children":[["$","p","0",{"children":"常见误解是“满五年就一定是 Resident”。正确理解是：F1 的前五个“日历年”通常不计入 SPT。比如，如果 2021 年入境，则 2021–2025 为 Non-Resident，2026 年才可能成为 Resident。这里的关键是“日历年”，只要某年在美国停留过一天，这一年就算 1 年。"}],["$","p","1",{"children":"因此，报税身份切换不是突然发生的，而是一个可以提前预判的过程。你需要知道自己的入境年份、当年报税年度，以及是否已经到第 6 个日历年。"}]]}]]}]
