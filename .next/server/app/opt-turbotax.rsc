1d:[["$","title","0",{"children":"2026 F1/OPT 留学生 TurboTax 适用性判定工具 - 免费精准路径判断 · MapleWorld"}],["$","meta","1",{"name":"description","content":"担心用错 TurboTax 影响身份？本工具基于 IRS SPT 规则，通过 8 个简单问题为您判定 2026 报税路径（NRA vs RA），提供精准的报税软件选择建议与风险提示。"}],["$","meta","2",{"name":"author","content":"MapleWorld Team"}],["$","meta","3",{"name":"keywords","content":"MapleWorld,2026 报税,Form 8843,留学生"}],["$","link","4",{"rel":"canonical","href":"https://www.mapleworld.online/opt-turbotax"}],["$","meta","5",{"property":"og:title","content":"MapleWorld - 2026 留学生报税指南"}],["$","meta","6",{"property":"og:description","content":"一站式解决留学生报税难题：Form 8843、W-2 缺失补救及身份自测。"}],["$","meta","7",{"property":"og:url","content":"https://www.mapleworld.online"}],["$","meta","8",{"property":"og:image","content":"https://www.mapleworld.online/og-image.png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"MapleWorld · opt 留学生报税"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"MapleWorld - 2026 留学生报税指南"}],["$","meta","15",{"name":"twitter:description","content":"一站式解决留学生报税难题：Form 8843、W-2 缺失补救及身份自测。"}],["$","meta","16",{"name":"twitter:image","content":"https://www.mapleworld.online/og-image.png"}],["$","meta","17",{"name":"twitter:image:width","content":"1200"}],["$","meta","18",{"name":"twitter:image:height","content":"630"}],["$","meta","19",{"name":"twitter:image:alt","content":"MapleWorld · opt 留学生报税"}],["$","link","20",{"rel":"icon","href":"/favicon.ico?favicon.ec1c61c1.ico","sizes":"256x256","type":"image/x-icon"}],["$","link","21",{"rel":"icon","href":"/favicon.ico"}],["$","$L23","22",{}]]
